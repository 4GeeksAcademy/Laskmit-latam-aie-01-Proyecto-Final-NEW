      "event_type": "performance_api_latency_recorded",
      "classification": "identificado",
      "category": "rendimiento",
      "delivery": "stream",
      "deliveryJustification": "Sampleado al 10%. La latencia necesita monitoreo en tiempo real para detectar degradaciones.",
      "description": "Un endpoint de la API completa su ejecución (medido desde el middleware de timing).",
