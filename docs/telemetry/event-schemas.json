            "description": "Oficina donde ocurre la operación."
          },
          "product_id": {
            "type": "integer",
            "description": "ID del producto."
          },
          "product_category": {
            "type": "string",
            "enum": ["training_kit", "certification", "onboarding_equipment"],
            "description": "Categoría del producto."
          },
          "programme_id": {
            "type": "string",
            "description": "Identificador del programa de formación."
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "description": "Cantidad entregada."
          },
          "currency": {
            "type": "string",
            "enum": ["EUR", "USD"],
            "description": "Moneda de la oficina."
