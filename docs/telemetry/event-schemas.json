{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nexova Telemetry Event Schemas",
  "description": "Catálogo completo de esquemas de eventos de telemetría para Nexova Operations. Cada evento define su event_type, descripción, allowlist de properties, metadata de clasificación y estrategia de entrega.",
  "version": "1.0",
  "eventEnvelope": {
    "type": "object",
    "required": ["eventId", "timestamp", "sessionId", "userId", "event_type", "schemaVersion", "requestId", "properties"],
    "properties": {
      "eventId": {
        "type": "string",
        "format": "uuid",
        "description": "Identificador único del evento (UUID v4). Se genera en el punto de emisión."
      },
      "timestamp": {
        "type": "string",
        "format": "date-time",
        "description": "Momento exacto en que ocurrió el evento en formato ISO 8601 (UTC)."
      },
      "sessionId": {
        "type": ["string", "null"],
        "format": "uuid",
        "description": "Identificador de la sesión del usuario. null en eventos batch o sin sesión."
      },
      "userId": {
        "type": ["string", "null"],
        "description": "Identificador del usuario que disparó el evento. null si no hay usuario autenticado."
      },
      "event_type": {
        "type": "string",
        "pattern": "^[a-z]+_[a-z]+$",
        "description": "Tipo de evento en formato entidad_accion con verbos en pasado."
      },
      "schemaVersion": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+$",
        "description": "Versión del esquema del evento (semver). Actual: 1.0."
      },
      "requestId": {
        "type": "string",
        "format": "uuid",
        "description": "Identificador de correlación para unir frontend-backend-logs."
      },
      "properties": {
        "type": "object",
        "description": "Payload específico del evento. Solo se permiten las claves definidas en el allowlist de cada evento."
      }
    }
  },
  "events": [
    {
      "event_type": "inbound_order_created",
      "classification": "obligatorio",
      "category": "negocio/inventario",
      "delivery": "stream",
      "description": "Se registra una orden de entrada de material desde un proveedor.",
      "sensitiveData": false,
      "piiStrategy": null,
      "properties": {
        "type": "object",
        "required": ["office", "product_id", "product_category", "programme_id", "quantity", "unit_cost", "currency", "supplier", "order_id"],
        "properties": {
          "office": {
            "type": "string",
            "enum": ["valencia", "miami"],
            "description": "Oficina donde ocurre la operación."
          },
          "product_id": {
            "type": "integer",
            "description": "ID del producto en la base de datos."
          },
          "product_category": {
            "type": "string",
            "enum": ["training_kit", "certification", "onboarding_equipment"],
            "description": "Categoría del producto."
          },
          "programme_id": {
            "type": "string",
            "description": "Identificador del programa de formación."
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "description": "Cantidad de unidades recibidas."
          },
          "unit_cost": {
            "type": "number",
            "minimum": 0,
            "description": "Costo unitario del material en la moneda de la oficina."
          },
          "currency": {
            "type": "string",
            "enum": ["EUR", "USD"],
            "description": "Moneda de la oficina. EUR para Valencia, USD para Miami."
          },
          "supplier": {
            "type": "string",
            "description": "Nombre del proveedor."
          },
          "order_id": {
            "type": "integer",
            "description": "ID de la orden de entrada en base de datos."
          }
        }
      }
    },
